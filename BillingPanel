import javax.swing.*;
import javax.swing.table.DefaultTableCellRenderer;
import javax.swing.table.DefaultTableModel;
import javax.swing.table.TableColumnModel;
import java.awt.*;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import java.sql.SQLException;
import java.time.LocalDate;
import java.time.format.DateTimeParseException;

public class BillingPanel extends JPanel {
    private static final String[] COLUMNS = {"ID", "Name", "Type", "Previous (kWh)", "Current (kWh)",
            "Consumption (kWh)", "Reading Date", "Total Bill"};

    private final AccountStore store;
    private final JTextField txtPrevious = UIHelper.field("0.0");
    private final JTextField txtCurrent = UIHelper.field("0.0");
    private final JTextField txtReadingDate = new JTextField(LocalDate.now().toString());

    private final JLabel lblSelName = new JLabel("No account selected");
    private final JLabel lblSelType = new JLabel("Pick a row from the table below");
    private final JLabel lblSelRate = new JLabel(" ");

    private final DefaultTableModel tableModel = new DefaultTableModel(COLUMNS, 0);
    private final JTable table = UIHelper.createTable(tableModel);

    public BillingPanel(AccountStore store) {
        super(new BorderLayout(10, 10));
        this.store = store;
        setBorder(BorderFactory.createEmptyBorder(15, 15, 15, 15));
        styleColumns();
        table.getSelectionModel().addListSelectionListener(ev -> {
            if (!ev.getValueIsAdjusting()) updateSelectedCard();
        });

        JPanel top = new JPanel(new GridLayout(1, 2, 15, 0));
        top.add(buildForm());
        top.add(buildSelectedCard());
        add(top, BorderLayout.NORTH);
        add(new JScrollPane(table), BorderLayout.CENTER);

        JButton btnCompute = new JButton("Compute Bill");
        UIHelper.stylePrimary(btnCompute);
        btnCompute.addActionListener(e -> computeBill());
        add(UIHelper.buttonRow(btnCompute), BorderLayout.SOUTH);

        store.addListener(this::refresh);
    }
    private JPanel buildForm() {
        JPanel form = new JPanel(new GridLayout(3, 2, 8, 12));
        form.setBorder(BorderFactory.createCompoundBorder(
                UIHelper.titledBorder("Enter Meter Reading"),
                BorderFactory.createEmptyBorder(6, 10, 10, 10)
        ));
        form.add(new JLabel("Previous Reading : "));
        form.add(txtPrevious);
        form.add(new JLabel("Current Reading : "));
        form.add(txtCurrent);
        form.add(new JLabel("Reading Date : "));
        form.add(buildDatePicker());
        return form;
    }
    private JPanel buildDatePicker() {
        txtReadingDate.setEditable(false);
        txtReadingDate.setHorizontalAlignment(SwingConstants.CENTER);
        txtReadingDate.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
        txtReadingDate.addMouseListener(new MouseAdapter() {
            @Override
            public void mouseClicked(MouseEvent e) {
                chooseDate();
            }
        });

        JButton btnPickDate = new JButton("Choose Date");
        UIHelper.styleAccent(btnPickDate);
        btnPickDate.addActionListener(e -> chooseDate());

        JPanel datePanel = new JPanel(new BorderLayout(6, 0));
        datePanel.add(txtReadingDate, BorderLayout.CENTER);
        datePanel.add(btnPickDate, BorderLayout.EAST);
        return datePanel;
    }

    private JPanel buildSelectedCard() {
        JPanel card = new JPanel(new GridLayout(3, 1, 0, 6));
        card.setBackground(UIHelper.LIGHT_GREEN);
        card.setBorder(BorderFactory.createCompoundBorder(
                UIHelper.titledBorder("Selected Account"),
                BorderFactory.createEmptyBorder(6, 10, 10, 10)
        ));
        lblSelName.setFont(lblSelName.getFont().deriveFont(Font.BOLD, 16f));
        lblSelName.setForeground(UIHelper.DARK_GREEN);
        card.add(lblSelName);
        card.add(lblSelType);
        card.add(lblSelRate);
        return card;
    }

    private void updateSelectedCard() {
        Billable b = store.getSelected(table);
        if (b == null) {
            lblSelName.setText("No account selected");
            lblSelType.setText("Pick a row from the table below");
            lblSelRate.setText(" ");
            txtPrevious.setText("");
            txtPrevious.setEditable(true);
        } else {
            lblSelName.setText(AccountStore.nameOf(b) + "  (" + AccountStore.idOf(b) + ")");
            lblSelType.setText("Account type: " + b.getBillableType());
            lblSelRate.setText(String.format("Rate: PHP %.2f per kWh", b.getRatePerKwh()));

            MeterReading last = store.getReading(b);
            if (last == null) {
                txtPrevious.setText("");
                txtPrevious.setEditable(true);
            } else {
                txtPrevious.setText(String.valueOf(last.getCurrentReading()));
                txtPrevious.setEditable(false);
            }
        }
    }

    private void refresh() {
        tableModel.setRowCount(0);
        for (Billable b : store.getAccounts()) {
            MeterReading r = store.getReading(b);
            Object[] row;
            if (r == null) {
                row = new Object[]{AccountStore.idOf(b), AccountStore.nameOf(b), b.getBillableType(),
                        "-", "-", "-", "-", "-"};
            } else {
                row = new Object[]{AccountStore.idOf(b), AccountStore.nameOf(b), b.getBillableType(),
                        String.format("%,.2f", r.getPreviousReading()),
                        String.format("%,.2f", r.getCurrentReading()),
                        String.format("%,.2f", r.getConsumption()),
                        r.getReadingDate(),
                        String.format("PHP %,.2f", b.calculateBill(r))};
            }
            tableModel.addRow(row);
        }
    }

    private void styleColumns() {
        DefaultTableCellRenderer center = new DefaultTableCellRenderer();
        center.setHorizontalAlignment(SwingConstants.CENTER);
        DefaultTableCellRenderer right = new DefaultTableCellRenderer();
        right.setHorizontalAlignment(SwingConstants.RIGHT);
        DefaultTableCellRenderer total = new DefaultTableCellRenderer() {
            @Override
            public Component getTableCellRendererComponent(JTable t, Object v, boolean sel,
                                                           boolean foc, int r, int c) {
                Component comp = super.getTableCellRendererComponent(t, v, sel, foc, r, c);
                comp.setFont(comp.getFont().deriveFont(Font.BOLD));
                if (!sel) comp.setForeground(UIHelper.DARK_GREEN);
                return comp;
            }
        };
        total.setHorizontalAlignment(SwingConstants.RIGHT);

        int[] widths = {80, 200, 110, 120, 120, 150, 110, 130};
        TableColumnModel cm = table.getColumnModel();
        for (int i = 0; i < widths.length; i++) {
            cm.getColumn(i).setPreferredWidth(widths[i]);
        }
        cm.getColumn(2).setCellRenderer(center);
        cm.getColumn(3).setCellRenderer(right);
        cm.getColumn(4).setCellRenderer(right);
        cm.getColumn(5).setCellRenderer(right);
        cm.getColumn(6).setCellRenderer(center);
        cm.getColumn(7).setCellRenderer(total);
    }
    private void chooseDate() {
        LocalDate initial;
        try {
            initial = LocalDate.parse(txtReadingDate.getText().trim());
        } catch (DateTimeParseException ex) {
            initial = LocalDate.now();
        }
        try {
            LocalDate picked = CalendarDialog.pick(this, initial);
            if (picked != null) txtReadingDate.setText(picked.toString());
        } catch (Exception ex) {
            ex.printStackTrace();
            UIHelper.error(this, "Calendar Error", "Could not open the calendar:\n" + ex);
        }
    }

    private void computeBill() {
        Billable selected = store.getSelected(table);
        if (selected == null) {
            UIHelper.warn(this, "Warning", "Select an account row from the table first.");
            return;
        }
        try {
            double previous = Double.parseDouble(txtPrevious.getText().trim());
            double current = Double.parseDouble(txtCurrent.getText().trim());
            String date = txtReadingDate.getText().trim();
            LocalDate.parse(date);
            MeterReading reading = new MeterReading(previous, current, date);
            double bill = selected.calculateBill(reading);

            DatabaseHelper.saveReading(selected, reading, bill);
            store.putReading(selected, reading);
            int selRow = table.getSelectedRow();
            refresh();
            if (selRow >= 0 && selRow < table.getRowCount()) {
                table.setRowSelectionInterval(selRow, selRow);
            }

            ReceiptDialog.show(this, selected, reading, bill);
            txtPrevious.setText("");
            txtCurrent.setText("");
            txtReadingDate.setText(LocalDate.now().toString());
        } catch (NumberFormatException ex) {
            UIHelper.error(this, "Input Error", "Please type valid numbers for both readings");
        } catch (IllegalArgumentException ex) {
            UIHelper.warn(this, "Validation Error", ex.getMessage());
        } catch (DateTimeParseException ex) {
            UIHelper.warn(this, "Validation Error", "Reading date must be a real date in YYYY-MM-DD format.");
        } catch (SQLException ex) {
            UIHelper.error(this, "Database Error", "Could not save the reading: " + ex.getMessage());
        }
    }
}
